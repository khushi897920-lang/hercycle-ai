# HerCycle AI — Environment Variables Template
# Copy this file to .env.local and fill in the values.

# ------------------------------------------------------------
# 1. App Configuration
# ------------------------------------------------------------
# The base URL of the app, used for CORS and meta tags
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Security headers (see lib/security-headers.js)
# ------------------------------------------------------------
# Content-Security-Policy enforcement.
#
# The app previously shipped a CSP consisting of `frame-ancestors 'self';`
# alone, which duplicates X-Frame-Options and constrains nothing else — an
# absent CSP directive means unrestricted, not denied. The real policy is now
# built in lib/security-headers.js, but it ships in Report-Only mode so
# violations can be collected before anything is blocked.
#
# Leave unset (or 'true') to report only. Set to exactly 'false' to enforce,
# once the violation reports from your deployment are clean.
CSP_REPORT_ONLY=true

# Origins allowed to make credentialed cross-origin API calls, comma
# separated. Falls back to NEXT_PUBLIC_APP_URL when unset.
#
# Leave empty unless something genuinely calls the API from another origin.
# No value means no Access-Control-Allow-Origin header at all, which is the
# correct refusal — the browser blocks the read and nothing has to say so.
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------
# 2. Supabase Database Configuration
# ------------------------------------------------------------
# Your Supabase Project API URL (found in Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key (used on the client-side browser, subject to RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here

# Service role key (bypasses RLS, used STRICTLY on the server-side Next.js routes)
# ⚠️ WARNING: Never expose this key in git, frontend files, or logs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------
# 2. Clerk Authentication Configuration
# ------------------------------------------------------------
# Clerk publishable key (exposed on the browser to load user sessions)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# Clerk secret API key (server-only, verified by middleware and auth contexts)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_here

# Clerk Webhook Secret (used to verify incoming user.deleted webhooks from Clerk)
# Found in Clerk Dashboard -> Webhooks -> Add Endpoint -> Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret_here

# Server-side key that anonymous community aliases are derived from.
#
# Aliases used to be an unsalted sha256() of the Clerk user id, so anyone
# holding a user id could compute that user's forum name and find every post
# she had written. Derivation is now HMAC-keyed with this value.
#
# Optional: when unset, SUPABASE_SERVICE_ROLE_KEY is used, which is already
# required on every server that runs this code and is stable across deploys.
# Set it explicitly if you would rather not reuse that key for two purposes.
#
# Must be stable — changing it renames every user. Existing posts keep the
# alias stored on the row, so history stays consistent either way.
# Generate with: openssl rand -base64 48
FORUM_ALIAS_SECRET=

# ------------------------------------------------------------
# Web Push (background notifications: love notes, period alerts)
# ------------------------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
#
# Both are optional — with neither set, the notification settings screen says
# background push is not available on this server instead of claiming it was
# enabled. What must NOT happen is the placeholder pair that used to be
# hard-coded as a default: it is not a valid P-256 key pair, so every send
# failed while the UI reported success.
#
# Changing the pair invalidates every stored subscription; users have to
# re-enable notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ------------------------------------------------------------
# 3. AI Integrations
# ------------------------------------------------------------
# Google Gemini API key (for primary chat assistant queries)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# Groq API key (for fallback Chat Assistant queries, optional)
GROQ_API_KEY=gsk_your_groq_key_here

# ------------------------------------------------------------
# 4. Machine Learning Microservice
# ------------------------------------------------------------
# The base URL of the Python FastAPI ML microservice (local development)
ML_SERVICE_URL=http://localhost:8000
